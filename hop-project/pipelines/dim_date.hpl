  <transform>
    <type>ExecSql</type>
    <name>Execute SQL script</name>
    <connection>lab_dw_postgres</connection>
    <sql>INSERT INTO dw.dim_date
(
    date_key,
    full_date,
    year_num,
    quarter_num,
    month_num,
    month_name,
    day_num,
    day_name,
    is_weekend
)
SELECT
    TO_CHAR(d, 'YYYYMMDD')::integer AS date_key,
    d::date AS full_date,
    EXTRACT(YEAR FROM d)::smallint AS year_num,
    EXTRACT(QUARTER FROM d)::smallint AS quarter_num,
    EXTRACT(MONTH FROM d)::smallint AS month_num,
    TRIM(TO_CHAR(d, 'Month')) AS month_name,
    EXTRACT(DAY FROM d)::smallint AS day_num,
    TRIM(TO_CHAR(d, 'Day')) AS day_name,
    CASE
        WHEN EXTRACT(ISODOW FROM d) IN (6, 7) THEN TRUE
        ELSE FALSE
    END AS is_weekend
FROM generate_series(
    DATE '2020-01-01',
    DATE '2030-12-31',
    INTERVAL '1 day'
) AS g(d)
WHERE NOT EXISTS
(
    SELECT 1
    FROM dw.dim_date existing
    WHERE existing.date_key = TO_CHAR(d, 'YYYYMMDD')::integer
);</sql>
    <execute_each_row>N</execute_each_row>
